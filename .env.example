# =========================================
# VoxAeterna 环境变量配置文件
# 复制此文件为 .env 并根据需要修改
# =========================================

# ---------- 本地推理后端 (FastAPI) ----------
VOX_INFERENCE_HOST=127.0.0.1
VOX_INFERENCE_PORT=9880
VOX_INFERENCE_DEVICE=cuda
VOX_INFERENCE_IS_HALF=true

# ---------- 云端服务 ----------
VOX_CLOUD_HOST=0.0.0.0
VOX_CLOUD_PORT=8000

# ---------- JWT 密钥 ----------
VOX_SECRET_KEY=change-this-to-a-random-secret-in-production

# ---------- 数据库 ----------
VOX_DB_USER=root
VOX_DB_PASS=123456
VOX_DB_HOST=127.0.0.1
VOX_DB_PORT=3306
VOX_DB_NAME=voxaeterna

# ---------- SMTP 邮件（QQ邮箱：smtp.qq.com:587，密码填授权码） ----------
VOX_SMTP_HOST=smtp.qq.com
VOX_SMTP_PORT=587
VOX_SMTP_USER=1605494775@qq.com
VOX_SMTP_PASS=hjxtunttopqbbadg
VOX_SMTP_FROM=1605494775@qq.com

# ---------- 支付宝当面付（在 open.alipay.com 申请「自研开发者」- 当面付） ----------
# 如果不填这三项，支付功能自动降级为开发模式（订单 pending，无二维码）
VOX_ALIPAY_APP_ID=
VOX_ALIPAY_PRIVATE_KEY=
VOX_ALIPAY_PUBLIC_KEY=
VOX_ALIPAY_NOTIFY_URL=https://your-domain.com/api/v1/subscription/callback
